# ContentLedger — example environment. Real values live only in .env (gitignored)
# and in Railway Variables / GitHub repository Variables (Pages). No secret in the repository.

# ── Network ────────────────────────────────────────────────────────────────
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE_ME
# The WebSocket is required: an agent's deposit is picked up through accountSubscribe,
# not by polling — without it 1,000 requests per session eat the RPC quota (SC-008).
SOLANA_WS_URL=wss://devnet.helius-rpc.com/?api-key=REPLACE_ME

PROGRAM_ID=HFoHycv5MSCFizdb4GhPSYgLWFfwu1MgEW8qx8zuWKh2
# A test mint with 6 decimals created by tools/deploy on devnet — not Circle's USDC,
# and the demo says so out loud. Pinned in Config for good: any other value here
# stops bootstrap as a mismatch.
USDC_MINT=F2snBajNcBXZ6GheR5LPhMvc9Ai2vG9uGweXrciNM1oF

# ── Database ───────────────────────────────────────────────────────────────
# Port 6543 (transaction pooler) is required: there are three server processes
# (gateway, settler, attestor) plus migrations, and the free tier gives 2 connections.
# Prepared statements do not work through pgbouncer — the driver runs with prepare: false.
DATABASE_URL=postgresql://user:password@host:6543/postgres
# Migrations (DDL) need session mode: the same pooler host on port 5432. The direct
# db.<ref>.supabase.co:5432 is IPv6-only and does not resolve from IPv4 networks.
DATABASE_MIGRATION_URL=postgresql://user:password@host:5432/postgres
# The gateway LISTENs for settled batches on one long-lived session: session mode again,
# port 5432, since the transaction pooler does not keep a session between statements.
DATABASE_LISTEN_URL=postgresql://user:password@host:5432/postgres

# ── Gateway ────────────────────────────────────────────────────────────────
# 8080 is often taken by Steam: binding 0.0.0.0 succeeds, but localhost answers with
# steamwebhelper, and the cause looks like an application error.
PORT=8879
# Proxies in front of the gateway that append to X-Forwarded-For. 0 takes the socket
# address; behind a hosting proxy set the measured hop count, or every client shares one
# rate-limit budget — and a wrong, too large value lets clients pick their own address.
TRUSTED_PROXY_HOPS=0
# The dashboard's origin (scheme, host, port; no path). It is the only site allowed to
# call the sign-in endpoints from a browser, and the domain publishers' wallets sign for —
# a signature made for any other site is refused. On Pages: https://<owner>.github.io
DASHBOARD_ORIGIN=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# The operator key signs settle_batch. It cannot spend escrow beyond the cumulative
# amount the agent signed. The path points outside the repository.
OPERATOR_KEYPAIR_PATH=./.secrets/operator-devnet.keypair.json

# ── Settler ────────────────────────────────────────────────────────────────
SETTLE_INTERVAL_SECONDS=60
# A batch costs two signatures in fees whatever its size: an agent is settled once it
# has this many unbatched receipts, or once the oldest has waited SETTLE_MAX_AGE_SECONDS
# (keep it below Config.voucher_grace_s), or at once after a withdrawal request.
SETTLE_MIN_RECEIPTS=10
SETTLE_MAX_AGE_SECONDS=300
# Caps receipts per batch, i.e. the size of the published composition. The packet limit
# depends on distinct recipients, and the settler measures that on the built transaction.
SETTLE_MAX_BATCH_SIZE=50

# ── Fixture corpus ─────────────────────────────────────────────────────────
FIXTURES_PORT=8880
# The gateway proxies registered sources only: source is a registry lookup key,
# not a URL to fetch, otherwise the gateway becomes an open SSRF proxy.
FIXTURES_BASE_URL=http://localhost:8880

# ── Attestor (M4) ──────────────────────────────────────────────────────────
ATTESTOR_KEYPAIR_PATH=./.secrets/attestor-devnet.keypair.json

# ── Agent simulator (devnet) ───────────────────────────────────────────────
AGENT_KEYPAIR_PATH=./.secrets/agent-devnet.keypair.json
# The agent keeps its journal of signed vouchers beside the key (*.journal.json): losing
# it means the agent can no longer extend its own chain until the settler catches up.
GATEWAY_URL=http://127.0.0.1:8879

# ── Dashboard (Vite; the VITE_ prefix makes a variable public) ─────────────
# On GitHub Pages it is set as a repository Variable, not here: Pages lives on
# github.io and the gateway does not, so "the page's own origin" does not work there.
# Unset — the page calls its own origin, and in development Vite proxies /v1.
VITE_API_URL=
VITE_SOLANA_CLUSTER=devnet
