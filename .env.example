# ContentLedger — приклад оточення. Реальні значення тільки в .env (у .gitignore)
# і в Railway/Vercel Variables. Жодного секрету в репозиторії.

# ── Мережа ─────────────────────────────────────────────────────────────────
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=REPLACE_ME
# WebSocket обовʼязковий: депозит агента підхоплюється через accountSubscribe,
# а не опитуванням — без цього 1 000 запитів на сесію зʼїдають ліміт RPC (SC-008).
SOLANA_WS_URL=wss://devnet.helius-rpc.com/?api-key=REPLACE_ME

PROGRAM_ID=HFoHycv5MSCFizdb4GhPSYgLWFfwu1MgEW8qx8zuWKh2
# Офіційний devnet-мінт USDC може бути обмежений — тоді власний тестовий мінт
# із 6 знаками, і демо називає це вголос (PLAN.md → Ризики).
USDC_MINT=REPLACE_ME

# ── База даних ─────────────────────────────────────────────────────────────
# Порт 6543 (transaction pooler) обовʼязковий: серверних процесів троє
# (gateway, settler, attestor) плюс міграції, а free tier дає 2 конекшени.
# З pgbouncer prepared statements не працюють — драйвер із prepare: false.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# ── Шлюз ───────────────────────────────────────────────────────────────────
# 8080 зайнятий Steam: бінд на 0.0.0.0 вдається, але localhost віддає
# steamwebhelper, і причина виглядає як помилка застосунку.
PORT=8879
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Операторський ключ підписує settle_batch. Витратити escrow понад підписаний
# агентом cumulative він не може. Шлях — поза репозиторієм.
OPERATOR_KEYPAIR_PATH=./.secrets/operator-devnet.keypair.json

# ── Сетлер ─────────────────────────────────────────────────────────────────
SETTLE_INTERVAL_SECONDS=60
# Стеля квитанцій в одному батчі. Ріже транзакцію під ліміт 1232 байти.
SETTLE_MAX_BATCH_SIZE=50

# ── Корпус фікстур ─────────────────────────────────────────────────────────
FIXTURES_PORT=8880
# Шлюз проксює тільки зареєстровані джерела: source — ключ пошуку в реєстрі,
# а не URL для завантаження, інакше шлюз стає відкритим SSRF-проксі.
FIXTURES_BASE_URL=http://localhost:8880

# ── Атестатор (M4) ─────────────────────────────────────────────────────────
ATTESTOR_KEYPAIR_PATH=./.secrets/attestor-devnet.keypair.json

# ── Агент-симулятор (devnet) ───────────────────────────────────────────────
AGENT_KEYPAIR_PATH=./.secrets/agent-devnet.keypair.json

# ── Дашборд (Vite, префікс VITE_ робить змінну публічною) ───────────────────
# Не задано — сторінка стукає у власний origin, а в розробці /v1 проксює Vite.
VITE_API_URL=
VITE_SOLANA_CLUSTER=devnet
